package partials

import (
	"context"
	"fmt"
	"net/url"
	"strings"

	"github.com/damongolding/immich-kiosk/internal/config"
	"github.com/damongolding/immich-kiosk/internal/immich"
	"github.com/damongolding/immich-kiosk/internal/kiosk"
)

func checkAuthParam(queries url.Values) (bool, string, string) {
	if queries.Has("password") {
		return true, queries.Get("password"), "password"
	}
	if queries.Has("authsecret") {
		return true, queries.Get("authsecret"), "authsecret"
	}
	return false, "", ""
}

type RedirectGroup struct {
	Category  string
	Redirects []config.RedirectItem
}

func groupRedirects(redirects []config.RedirectItem) []RedirectGroup {
	var groups []RedirectGroup
	categoryMap := make(map[string]int)

	noCategoryGroup := RedirectGroup{Category: ""}

	for _, r := range redirects {
		if r.Category == "" {
			noCategoryGroup.Redirects = append(noCategoryGroup.Redirects, r)
			continue
		}

		idx, exists := categoryMap[r.Category]
		if !exists {
			groups = append(groups, RedirectGroup{
				Category:  r.Category,
				Redirects: []config.RedirectItem{r},
			})
			categoryMap[r.Category] = len(groups) - 1
		} else {
			groups[idx].Redirects = append(groups[idx].Redirects, r)
		}

	}

	if len(noCategoryGroup.Redirects) > 0 {
		return append([]RedirectGroup{noCategoryGroup}, groups...)
	}

	return groups
}

templ RedirectList(redirects []config.RedirectItem, hasPassword bool, password, paramType string) {
	for _, redirect := range redirects {
		{{ redirectName, _ := strings.CutPrefix(redirect.Name, "/") }}
		if hasPassword {
			<a href={ templ.SafeURL(fmt.Sprintf("/%s?%s=%s", redirectName, paramType, password)) }>{ redirectName }</a>
		} else {
			<a href={ templ.SafeURL(fmt.Sprintf("/%s", redirectName)) }>{ redirectName }</a>
		}
	}
}

func albumRedirectURL(rawURL, paramType, password string) string {
	target, err := url.Parse(rawURL)
	if err != nil {
		return rawURL
	}

	values := target.Query()
	values.Set(paramType, password)
	target.RawQuery = values.Encode()

	return target.String()
}

templ AlbumRedirectList(redirects []config.RedirectItem, hasPassword bool, password, paramType string) {
	for _, redirect := range redirects {
		if hasPassword {
			<a href={ templ.SafeURL(albumRedirectURL(redirect.URL, paramType, password)) }>{ redirect.Name }</a>
		} else {
			<a href={ templ.SafeURL(redirect.URL) }>{ redirect.Name }</a>
		}
	}
}

func albumRedirects(ctx context.Context, c config.Config) []config.RedirectItem {
	var albumRedirects []config.RedirectItem

	a := immich.New(ctx, c)

	albums, err := a.AllAlbums(kiosk.GlobalCache, a.DeviceID)
	if err != nil {
		return albumRedirects
	}

	for _, album := range albums {
		albumRedirects = append(albumRedirects, config.RedirectItem{
			Name: album.AlbumName,
			URL:  "/?album=" + album.ID,
			Type: "external",
		})
	}

	return albumRedirects
}

templ Redirects(c config.Config, redirects config.Redirects, queries url.Values) {
	{{
	hasPassword, password, paramType := checkAuthParam(queries)
	groupedRedirects := groupRedirects(redirects.Items)
	}}
	<div id="redirects-container">
		<div class="redirects">
			<div class="redirects--shadow">
				for _, group := range groupedRedirects {
					if group.Category == "" {
						@RedirectList(group.Redirects, hasPassword, password, paramType)
					} else {
						<div class="redirect-category">
							<h3 class="category-title">{ group.Category }</h3>
							@RedirectList(group.Redirects, hasPassword, password, paramType)
						</div>
					}
				}
				if redirects.ShowAlbums {
					<div
						class="redirect-category"
						hx-get={ fmt.Sprintf("/redirects/albums?%s", queries.Encode()) }
						hx-trigger="load"
						hx-swap="outerHTML"
					></div>
				}
			</div>
		</div>
	</div>
}

templ AlbumRedirectsFragment(c config.Config, queries url.Values, ctx context.Context) {
	{{
	hasPassword, password, paramType := checkAuthParam(queries)
	albumRedirects := albumRedirects(ctx, c)
	}}
	<div class="redirect-category">
		<h3 class="category-title">Albums</h3>
		@AlbumRedirectList(albumRedirects, hasPassword, password, paramType)
	</div>
}
