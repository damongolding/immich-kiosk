package partials

// Spinner renders a loading spinner
templ SpinnerRotate() {
	<img
		class="kiosk--spinner-rotate"
		src="/assets/images/spinner_rotate.gif"
		alt="Loading spinner"
	/>
}

templ SpinnerRotateInline() {
	<img
		class="kiosk--spinner-rotate"
		alt="Loading spinner"
		src="data:image/gif;base64,"
	/>
}
